# Настройки измерения покрытия (coverage.py).
#
# Тесты запускают s3_sync.py отдельным процессом, поэтому в CI рядом с этим
# файлом создаётся .pth-хук, а тесты запускаются с COVERAGE_PROCESS_START,
# указывающим на этот файл: так покрытие собирается и в дочерних процессах,
# а `coverage combine` склеивает результаты.

[run]
branch = True
parallel = True
# Измеряем только сам продукт: тесты и вспомогательный мини-S3 в проценты
# не попадают, иначе картина завышается (код тестов исполняется всегда).
include =
    s3_sync.py

[report]
# Ниже этого порога `coverage report` завершается ошибкой — это и есть гейт в CI.
# Фактическое покрытие на момент добавления замера — 78%, порог взят с запасом.
fail_under = 75
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
