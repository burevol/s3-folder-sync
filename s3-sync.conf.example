# Пример конфигурации для s3_sync.py
#
# Скопируйте в s3-sync.conf рядом со скриптом (или в ~/.config/s3-sync/s3-sync.conf),
# поправьте под себя и проверьте подключение:
#
#     cp s3-sync.conf.example s3-sync.conf
#     python s3_sync.py --config s3-sync.conf --check --check-write
#     python s3_sync.py --config s3-sync.conf --dry-run --verbose
#     python s3_sync.py --config s3-sync.conf
#
# Формат — TOML (https://toml.io). Комментарии начинаются с #.

# ---------------------------------------------------------------------------
# Куда складывать. Значения берутся из панели управления Спринтбокс:
# раздел S3 -> ваш бакет -> «Данные для подключения».
# ---------------------------------------------------------------------------
[storage]
endpoint_url = "https://s3.spb.sprinthost.ru"
region = "spb"
bucket = "s3-123456"          # поле «Name» из панели управления

# path    — https://s3.spb.sprinthost.ru/бакет/ключ (значение по умолчанию,
#           работает всегда, рекомендуется);
# virtual — https://бакет.s3.spb.sprinthost.ru/ключ (тоже поддерживается,
#           сертификат выписан на *.s3.sprinthost.ru);
# auto    — выбрать автоматически средствами boto3.
addressing_style = "path"

# s3v4 — подпись AWS Signature Version 4 (то, что поддерживает Спринтбокс).
signature_version = "s3v4"

# ---------------------------------------------------------------------------
# Ключи доступа. Выберите ОДИН из способов.
#
# 1) Переменные окружения (рекомендуется) — тогда в этом файле про ключи
#    ничего писать не нужно:
#       export S3_SYNC_ACCESS_KEY="Access Key из панели"
#       export S3_SYNC_SECRET_KEY="Secret Access Key из панели"
#    Скрипт понимает и стандартные AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
#
# 2) Профиль в ~/.aws/credentials (рекомендуется, если ключей несколько):
#       [sprintbox-test]
#       aws_access_key_id = ...
#       aws_secret_access_key = ...
#    и здесь:
# profile = "sprintbox-test"
#
# 3) Отдельный файл с ключами в том же формате (права 600):
# credentials_file = "~/.config/s3-sync/credentials"
#
# 4) Ключи прямо в этом файле (просто, но менее безопасно):
#    обязательно chmod 600 s3-sync.conf
# access_key = "..."
# secret_key = "..."
# ---------------------------------------------------------------------------

# Предохранитель: если за один запуск нужно удалить больше объектов, чем здесь
# указано, удаление не выполняется без --force. 0 — без ограничения.
max_deletes = 100

# Порог перехода на multipart-загрузку и размер части.
multipart_threshold = "64M"
multipart_chunksize = "16M"

# ---------------------------------------------------------------------------
# Значения по умолчанию для всех папок.
# ---------------------------------------------------------------------------
[defaults]
# Удалять в хранилище то, чего больше нет локально (это и есть синхронизация).
delete = true
exclude = [".DS_Store", "Thumbs.db", "desktop.ini", "*.tmp", "*.swp", "*~", ".git/**"]

# ---------------------------------------------------------------------------
# Что синхронизировать. Секций [[folders]] может быть сколько угодно.
#
# local  — локальный путь: абсолютный или относительный (тогда он считается
#          от каталога, в котором лежит конфигурационный файл);
# prefix — «папка» внутри бакета; ключ объекта = prefix + "/" + путь внутри local.
#          Префиксы у разных папок не должны совпадать или вкладываться друг в друга.
# ---------------------------------------------------------------------------
[[folders]]
name = "site"
local = "/var/www/example.com"
prefix = "backups/site"
delete = true

[[folders]]
name = "configs"
local = "../configs"
prefix = "backups/configs"
# Свой список исключений дополняет exclude из [defaults].
exclude = ["*.log", "cache/**"]

# Пример папки только на загрузку, без удаления:
# [[folders]]
# name = "docs"
# local = "D:/Docs"
# prefix = "docs"
# delete = false
